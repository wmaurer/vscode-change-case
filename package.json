{
    "name": "change-case",
    "displayName": "change-case",
    "version": "2.1.0",
    "description": "Quickly change the case (camelCase, CONSTANT_CASE, snake_case, etc) of the current selection or current word",
    "categories": [
        "Other"
    ],
    "bugs": {
        "url": "https://github.com/wmaurer/vscode-change-case/issues"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/wmaurer/vscode-change-case.git"
    },
    "publisher": "wmaurer",
    "files": [
        "dist/extension.cjs",
        "images/change-case-icon.png",
        "LICENSE.md",
        "CHANGELOG.md"
    ],
    "type": "module",
    "main": "./dist/extension.cjs",
    "scripts": {
        "vscode:prepublish": "pnpm run package",
        "compile": "pnpm run typecheck && pnpm run lint && node esbuild.ts",
        "package": "pnpm run typecheck && pnpm run lint && node esbuild.ts --production",
        "vsix": "vsce package --no-dependencies",
        "publish:openvsx": "ovsx publish --no-dependencies",
        "watch": "pnpm run --parallel \"/^watch:/\"",
        "watch:esbuild": "node esbuild.ts --watch",
        "watch:tsc": "tsc -b --watch",
        "test": "node esbuild.ts && node esbuild.ts --tests && vscode-test",
        "typecheck": "tsc -b",
        "lint": "oxlint --disable-nested-config --no-error-on-unmatched-pattern --max-warnings=0",
        "lint:backlog": "oxlint --disable-nested-config --no-error-on-unmatched-pattern",
        "fmt": "oxfmt .",
        "fmt:check": "oxfmt --check .",
        "deps:fetch": "node scripts/repos.js deps fetch",
        "deps:check": "node scripts/repos.js deps check",
        "refs:fetch": "node scripts/repos.js refs fetch"
    },
    "dependencies": {
        "change-case": "^5.4.4",
        "sponge-case": "^2.0.3",
        "title-case": "^4.3.2"
    },
    "devDependencies": {
        "@oxlint/plugins": "1.86.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.19.0",
        "@types/vscode": "1.90.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.0.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "ovsx": "1.2.0",
        "oxfmt": "^0.72.0",
        "oxlint": "1.86.0",
        "oxlint-tsgolint": "7.0.2003",
        "typescript": "^7.0.2"
    },
