            {
                "command": "extension.changeCase.upper",
                "title": "upper",
                "category": "Change Case"
            },
            {
                "command": "extension.changeCase.upperFirst",
                "title": "upperFirst",
                "category": "Change Case"
            }
        ],
        "configuration": {
            "title": "Change Case",
            "properties": {
                "changeCase.includeDotInCurrentWord": {
                    "type": "boolean",
                    "default": false,
                    "scope": "language-overridable",
                    "description": "When a command runs on the word at the cursor, treat dots as part of the word."
                },
                "changeCase.selectConvertedText": {
                    "type": "boolean",
                    "default": true,
                    "scope": "language-overridable",
                    "description": "Select the converted text after a command. When off, the cursor goes to the end of the converted text."
                },
                "changeCase.separateNumbers": {
                    "type": "boolean",
                    "default": false,
                    "scope": "language-overridable",
                    "markdownDescription": "Treat numbers as separate words. For example, `snake` converts `firstName1` to `first_name_1`, but also `i18n` to `i_18_n`. This is the `splitSeparateNumbers` option of change-case."
                },
                "changeCase.mergeAmbiguousCharacters": {
                    "type": "boolean",
                    "default": false,
                    "scope": "language-overridable",
                    "markdownDescription": "In `camel` and `pascal`, join a word that starts with a number without an underscore. For example, `camel` converts `first_name_1` to `firstName1`, not `firstName_1`. This is the `mergeAmbiguousCharacters` option of change-case."
                },
                "changeCase.cycle": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "camel",
                            "constant",
                            "dot",
                            "kebab",
                            "lower",
                            "lowerFirst",
                            "no",
                            "param",
                            "pascal",
                            "pascalSnake",
                            "path",
                            "proseSentence",
                            "proseTitle",
                            "sentence",
                            "snake",
                            "sponge",
                            "swap",
                            "title",
                            "upper",
                            "upperFirst"
                        ]
                    },
                    "default": [
                        "camel",
                        "snake",
                        "constant",
                        "pascal",
                        "kebab"
                    ],
                    "scope": "language-overridable",
                    "markdownDescription": "The cases that `Change Case: Cycle` goes through, in order. Each run converts the text to the next case in the list that gives a different result."
                }
            }
        },
        "submenus": [
            {
                "id": "changeCase.editorContext",
                "label": "Change Case"
            }
        ],
